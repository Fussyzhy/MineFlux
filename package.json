{
  "name": "mineflux",
  "productName": "MineFlux",
  "version": "0.3.0",
  "private": true,
  "description": "MineFlux — standalone Minecraft version downloader with GUI (third-party, unofficial)",
  "author": "MineFlux",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "yarn run build:renderer && yarn run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "yarn run build && node scripts/launch.mjs",
    "smoke": "yarn run build && node scripts/launch.mjs --smoke",
    "smoke:install": "yarn run build && node scripts/launch.mjs --smoke --smoke-install=1.5.2",
    "e2e": "esbuild scripts/e2e.ts --bundle --platform=node --format=esm --outfile=.tmp/e2e.mjs --log-level=warning && node .tmp/e2e.mjs",
    "e2e:features": "esbuild scripts/e2e-features.ts --bundle --platform=node --format=esm --outfile=.tmp/e2e-features.mjs --log-level=warning && node .tmp/e2e-features.mjs",
    "test:ui": "esbuild scripts/test-ui.ts --bundle --platform=node --format=esm --outfile=.tmp/test-ui.mjs --log-level=warning && node .tmp/test-ui.mjs",
    "test:core": "esbuild scripts/test-core.ts --bundle --platform=node --format=esm --outfile=.tmp/test-core.mjs --log-level=warning && node .tmp/test-core.mjs",
    "dist": "yarn run build && electron-builder --win",
    "dist:win": "yarn run build && electron-builder --win nsis",
    "dist:portable": "yarn run build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.mineflux.downloader",
    "productName": "MineFlux",
    "copyright": "Copyright © 2026 MineFlux",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MineFlux",
      "artifactName": "MineFlux-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "MineFlux-${version}-portable.exe"
    }
  }
}
